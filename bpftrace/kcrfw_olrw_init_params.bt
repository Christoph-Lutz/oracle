        @lgwr_thick_mode_cfg_prm[pid] = retval;
    }
    else if (@p0[pid] == USE_SINGLE_LOG_WRITER_PRM) {
        @use_single_log_writer_prm[pid] = retval;
    }
    else if(@p0[pid] == TGT_LW_SZ_PCT_POKE_PRM){
        /* If poke_pct is not set at session level, use the default */
        @tgt_lw_sz_pct_poke_prm[pid] = retval == 0 ? DEFAULT_POKE_PCT : retval;
    }

    printf("%ld %s <- kspges: 0x%x (%d)\n", pid, comm, retval, retval);

    delete(@in_kspges[pid]);
    delete(@p0[pid]);
}

