        printf("%ld %s      opt_grp_sz = %u\n", pid ,comm, $olrw->opt_grp_sz);
    }

    printf("%ld %s <- kcrfw_olrw_init_params\n\n", pid, comm);

    delete(@in_trace[pid]);
    delete(@cpu_count[pid]);

