        printf("%ld %s      thick_p1 = %u\n", pid ,comm, $olrw->thick_p1);
        printf("%ld %s      fallback_zone_end = %u\n", pid ,comm, $olrw->fallback_zone_end );
        printf("%ld %s      thick_p2 = %u\n", pid ,comm, $olrw->thick_p2);
