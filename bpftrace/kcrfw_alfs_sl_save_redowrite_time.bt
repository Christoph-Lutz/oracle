#!/usr/bin/env -S bpftrace --no-warning
/*
 * Purpose:
 *   Trace calls to kcrfw_alfs_sl_save_redowrite_time to show how
 *   lgwr maintains a moving average of the redo write time that is
 *   used to decide if the Fast Log File Sync should be enabled or
 *   disabled. The decision to enable or disable the Fast Sync
 *   is taken in kcrfw_alfs_sl_update_mode (kcrfw adaptive log file
 *   sync smart log update mode). 
 *
 * Date:
 *   May-15 2025
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *   ./kcrfw_alfs_sl_save_redowrite_time.bt <oracle_sid>
 *
 * Tested on:
 *   Oracle 19.26 / Exadata 24.1.2
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 * 
 *   Floating point numbers are not supported by BPF, there-
 *   fore the script doesn't calculate the moving avg of the 
 *   redo write time and rather only emits the formula so that 
 *   you can do the calculation in a calculator.
 *  
 *   Use at your own risk!
 *
 * Background information:
 *   The moving avg is calculated in kcrfw_alfs_sl_save_
 *   redowrite_time, which gets called from kcrfw_post af-
 *   ter a log write (lgwr post-write processing).
 *
 *   Oracle tracks the Fast Sync status in sga variable
 *   kcrf_fast_sync_ (0=disabled/1=enabled). A mode switch
 *   to Fast Sync is evaluated in in kcrfw_alfs_sl_update_
 *   mode when the avg redo write time to a smart log (dax
 *   device) is less than the max threshold of 100 us; simi-
 *   larly, Fast Sync is disabled, when the avg redo write
 *   time to a smart log drops below the max threshold of
 *   100 us. Note that the status update to variable kcrfw_
 *   fast_sync_ is not performed in kcrfw_alfs_sl_update_mode
 *   directly, but rather via kcrf_handle_storage_switch -> 
 *   kcrf_switch_storage_params.
 *
 *   The latter code path gets also invoked on a redo log 
 *   switch (kcrfwl->kcrfnl->kcrf_handle_storage_witch->
 *   kcrf_switch_storage_params; however, the log switch 
 *   code path was not investigated further).
 *
 *   The moving average of the redo write time based on the 
 *   following formula:
 * 
 *   diff = curr_write_time - write_avg;
 *   write_avg += (diff * 2) / 129;
 * 
 *   The smoothing factor 2/129 (~0.0155) controls how fast 
 *   it adapts and smooths out spikes and dips.
 *
 *   kcrfw_alfs_savre_redowrite_time also increments the 
 *   number of smart log writes (tracked in sga variable 
 *   kspasv90_).
 */

/* Addresses and offsets my change in every RU!                        */
#define KSPSSIDST 0x60009628  /* oracle sid name                       */
#define KSPASV3   0x6000ace8  /* kspasv3_ (redo write time moving avg) */
#define KSPASV90  0x6000aec0  /* kspasv90_ smart log (sl) write count  */

BEGIN
{
    if ($# != 1) 
    {
        printf("\nUsage: ./kcrfw_alfs_sl_save_redowrite_time.bt <oracle_sid>\n");
        exit();
    }

    printf("\nTracing ... Hit Ctrl + C to stop.\n\n");
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_alfs_sl_save_redowrite_time
/ str(uptr(KSPSSIDST)) == str($1) /
{
    @trace[tid] = 1;
    $write_avg = *(uint32 *) uptr(KSPASV3);
    $write_cnt = *(uint32 *) uptr(KSPASV90);
    $fs = uptr(curtask->thread.fsbase);
    $tls_off = *(uint64 *) ($fs - 0xec78);
    $t1 = *(uint64 *) ($tls_off + 0x48);
    $t2 = *(uint64 *) ($tls_off + 0x50);
    $write_time = (int32) (($t2 - $t1) * 1000);
    $diff = (int32) ($write_time - $write_avg);

    printf("%ld %s -> kcrfw_alfs_sl_save_redowrite_time:\n", pid, comm);
    printf("%ld %s    write_avg = %u\n", pid, comm, $write_avg);
    printf("%ld %s    write_cnt = %u\n", pid, comm, $write_cnt);
    printf("%ld %s    t1 = %lu\n", pid, comm, $t1);
    printf("%ld %s    t2 = %lu\n", pid, comm, $t2);
    printf("%ld %s    write_time = (t2 - t1) * 1000 = %d\n", pid, comm, $write_time);
    printf("%ld %s    diff = write_time - write_avg = %d\n", pid, comm, $diff);
    printf("%ld %s    calculation: new_avg = write_avg + (diff * 2)/129 = %d + (%d * 2)/129\n", 
           pid, comm, $write_avg, $diff);

    /* Uncomment to print stack trace */
    // printf("%s\n", ustack());
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_alfs_sl_save_redowrite_time
/ @trace[tid] /
{
    $new_write_cnt = *(uint32 *) uptr(KSPASV90);
    $new_avg = *(uint32 *) uptr(KSPASV3);

    printf("%ld %s    effective: new_avg = %u\n", pid, comm, $new_avg);
    printf("%ld %s    new write_cnt = %u\n", pid, comm, $new_write_cnt);
    printf("%ld %s <- kcrfw_alfs_sl_save_redowrite_time\n\n", pid, comm);

    delete(@trace[tid]);
}

END
{
    clear(@trace);
}
