#!/usr/bin/env -S bpftrace --no-warning
/*
 * Purpose:
 *   Trace kcrfw_stats_writeinfo_insert calls to observe how
 *   Oracle populates the write info array with the lwn scn
 *   scn and the redo write completion timestamp after a redo 
 *   write completes.
 *
 * Date:
 *   Aug-02 2025
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *   BPFTRACE_CACHE_USER_SYMBOLS=1 ./kcrfw_stats_writeinfo_insert <oracle_sid> [<stacks>?]
 *
 * Tested on:
 *   Oracle 19.26 / Exadata 24.1.2
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 *  
 *   Use at your own risk!
 *
 * Background information:
 *  Elements in the write info array contain two fields:
 *    - lwn scn (log write number / logical write number?)
 *    - redo write end timestamp
 *
 *  Lgwr and lg worker processes use the write info array to
 *  track the timestamps of redo write completions in lwn scn
 *  order (kcrfw_post).
 *
 *  The redo write end timestamps are used by fg processs to
 *  calculate the redo synch  overhead when a transaction
 *  completes (via kcrf_commit_force_int -> kcrfw_stats_
 *  syncoverhead_record):
 *
 *    redo synch overhead = lfs end ts - redo write end ts
 *
 *  Lgwr and lg workers insert new entries into the write info
 *  array in "forward" order, whereas fg processes scan the
 *  write info array in "reverse" order.
 *
 *  Concurrent updates to the write info array are protected
 *  and serialized by the "log write info" latch.
 *
 *  On RAC, the write info array is also updated by lms and
 *  lmd processes (not investigated furhter).
 */

/* Addresses and offsets may change in every RU!                                */
#define KSPSSIDST_ADDR              0x60009628  /* sid name                     */
#define KCRF_WRITE_INFO             0x60022318  /* kcrf_write_info_             */
#define KCRF_WRITE_INFO_ARR_SZ_OFF  0x4         /* write info array size offset */
#define KCRF_WRITE_INFO_ARR_OFF     0x8         /* write info array offset      */
#define KCRF_WRITE_INFO_REC_SZ      0x10        /* write info array record size */
#define KCRF_WRITE_INFO_TS_OFF      0x8         /* write info timestamp offset  */

BEGIN
{
    if ($# < 1 || $# > 2) {
        printf("\nUsage: BPFTRACE_CACHE_USER_SYMBOLS=1 ./kcrfw_stats_writeinfo_insert <oracle_sid> [<stacks>?]\n\n");
        exit();
    }

    if (str($2) == "yes" || str($2) == "y" || str($2) == "stacks") {
        @OPT_STACKS = 1;
    }

    printf("\nTracing ... Hit Ctrl + C to stop.\n\n");
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_stats_writeinfo_insert
/ str(uptr(KSPSSIDST_ADDR)) == str($1) /
{
    @in_trace[pid] = 1;
    @write_info_idx[pid] = *(uint64 *) uptr(KCRF_WRITE_INFO);

    printf("%s %ld %s -> kcrfw_stats_writeinfo_insert: lwn_scn_p=%p\n", str(uptr(KSPSSIDST_ADDR)),  pid, comm, arg0);
    printf("%s %ld %s    *lwn_scn_p = %p\n", str(uptr(KSPSSIDST_ADDR)), pid, comm, *(uint64 *) arg0);

    if (@OPT_STACKS) {
        @stacks[comm, ustack()] = count();
    }
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_stats_writeinfo_insert
/ @in_trace[pid] /
{
    printf("%s %ld %s <- kcrfw_stats_writeinfo_insert\n", str(uptr(KSPSSIDST_ADDR)), pid, comm);

    delete(@in_trace[pid]);
    delete(@write_info_idx[pid]);
    delete(@latch_get[pid]);
    delete(@write_ts[pid]);
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kslgetl
/ @in_trace[pid] /
{
    printf("%s %ld %s    -> kslgetl: laddr=%p, wait=0x%x, ksllwlbl=0x%x, where=%d\n", 
           str(uptr(KSPSSIDST_ADDR)), pid, comm, arg0, arg1, arg2, arg3);
} 

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kslgetl
/ @in_trace[pid] /
{
    @latch_get[pid] = (uint32) retval;

    if (!retval) {
        printf("%s %ld %s       log write info latch get failed, skipping write info update.\n", str(uptr(KSPSSIDST_ADDR)), pid, comm);
    }

    printf("%s %ld %s    <- kslgetl: %d\n",  str(uptr(KSPSSIDST_ADDR)), pid, comm, retval);
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kslfre
/ @in_trace[pid] /
{
    /* 
     * Print write info details in kslfre 
     * probe to ensure the output matches 
     * the function flow.
     */
    if (@latch_get[pid]) {
        $write_info_idx = *(uint64 *) uptr(KCRF_WRITE_INFO);
        $write_info_sz  = *(uint32 *) uptr(KCRF_WRITE_INFO + KCRF_WRITE_INFO_ARR_SZ_OFF);
        $write_info_arr = *(uint64 *) uptr(KCRF_WRITE_INFO + KCRF_WRITE_INFO_ARR_OFF);
        $write_info_lwn = *(uint64 *) uptr($write_info_arr + (uint32)($write_info_idx * KCRF_WRITE_INFO_REC_SZ));
        $write_info_ts  = *(uint64 *) uptr($write_info_arr + (uint32)($write_info_idx * KCRF_WRITE_INFO_REC_SZ + KCRF_WRITE_INFO_TS_OFF));

        printf("%s %ld %s       arr = %p\n",  str(uptr(KSPSSIDST_ADDR)), pid, comm, $write_info_arr);
        printf("%s %ld %s       arr_sz = %u\n",  str(uptr(KSPSSIDST_ADDR)), pid, comm, $write_info_sz);
        printf("%s %ld %s       arr_idx: old = %u, new = %u\n", str(uptr(KSPSSIDST_ADDR)), pid, comm, @write_info_idx[pid], $write_info_idx);
        printf("%s %ld %s       lwn_scn = %p\n",  str(uptr(KSPSSIDST_ADDR)), pid, comm, $write_info_lwn);
        printf("%s %ld %s       write_ts = %lu\n",  str(uptr(KSPSSIDST_ADDR)), pid, comm, $write_info_ts);
        printf("%s %ld %s    -> kslfre: laddr=%p\n", str(uptr(KSPSSIDST_ADDR)), pid, comm, arg0);
    }
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:skgstmGetEpochTs
/ @in_trace[pid] /
{
    @write_ts[pid] = (uint64) retval;
    printf("%s %ld %s       <- skgstmGetEpochTs: %lu\n", str(uptr(KSPSSIDST_ADDR)), pid, comm, retval);
}

END
{
    clear(@in_trace);
    clear(@write_info_idx);
    clear(@write_ts);
    clear(@latch_get);
    clear(@OPT_STACKS);
}
