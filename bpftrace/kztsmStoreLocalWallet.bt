#!/usr/bin/env -S bpftrace --no-warnings
/*
 * Purpose:
 *  Probe the kztsmStoreLocalWallet, nurrf_rf_32, and
 *  related helper functions to illustrate how Oracle
 *  26ai protects local auto-login wallets (cwallet.sso)
 *  with a password that is derived from a hmac-sha256 
 *  that uses the following inputs:
 *    msg = sha256(hostname, username, machine id)
 *    key = randomly generated 32-byte valu
 *
 *  Oracle 26ai encodes the hmac-sha256 output using 
 *  base64 and uses it as the password to protect the 
 *  ewallet.p12 contents embedded in the cwallt.sso 
 *  file.
 *
 * Date:
 *   Sep-01 2026
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *   ./kztsmStoreLocalWallet.bt <pid>
 *
 * Tested on:
 *   Oracle 23.26.0 / Exadata 25.2.6
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 *
 *   Use at your own risk!
 */

struct ossl_param_st {
    const char *key;             /* the name of the parameter               */
    unsigned int data_type;      /* declare what kind of content is in data */
    void *data;                  /* value being passed in or out            */
    size_t data_size;            /* data size                               */
    size_t return_size;          /* returned size                           */
};

BEGIN
{
    printf("Tracing, hit ^C to stop ...\n\n");
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:kztsmStoreLocalWallet
/ pid == $1 /
{
    @in_trace[pid] = 1;
    printf("%ld %s -> kztsmStoreLocalWallet: %p, %p, %p, %p, %p, %p\n", pid, comm, arg0, arg1, arg2, arg3, arg4, arg5);
}

uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:kztsmStoreLocalWallet
/ @in_trace[pid] /
{
    printf("%ld %s <- kztsmStoreLocalWallet: 0x%lx (%d)\n", pid, comm, retval, retval); 
    delete(@in_trace[pid]);
}

