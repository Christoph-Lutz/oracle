#!/usr/bin/env -S bpftrace --no-warnings
/*
 * Purpose:
 *   Measure the elapsed time of Oracle function
 *   kkscsSearchChildList. This can be used to
 *   measure how long Oracle needs to scan a child
 *   cursor list. 
 * 
 *   Note that this script also counts the calls 
 *   to the kkscsCheckCursor function that Oracle
 *   uses to inspect a child cursor and check if 
 *   it can be shared. Probing this function can 
 *   incur significant overhead, depending on how 
 *   many child cursors are inspected.
 *
 * Date:
 *   Jun-08 2026
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *
 * Tested on:
 *   Oracle 23.26.0 / Exadata 25.2.1
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 * 
 *   Use at your own risk!
 */

BEGIN
{
    printf("Tracing... Hit ^C to stop.\n\n");

    if (str($1) == "verbose" || str($1) == "v" || str($1) == "yes" || str($1) == "y") {
        @OPT_VERBOSE = 1;
    }
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:kkscsSearchChildList
/ pid == $1 /
{
    @in_trace[pid] = 1;
    @start[pid] = nsecs;
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:kkscsCheckCursor
/ @in_trace[pid] /
{
    @checks[pid]++;
}

uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:kkscsSearchChildList
/ @in_trace[pid] /
{
    $ela_ns = (nsecs - @start[pid]);

    printf("%ld %s kkscsSearchChildList: inspected %u child cursors\n", pid, comm, @checks[pid]);
    printf("%ld %s kkscsSearchChildList: completed in %lu ns (%lu us)\n\n", pid, comm, $ela_ns, ($ela_ns/1e3));

    /* Set in kkscsCheckCursor retprobe */
    delete(@checks[pid]);

    delete(@in_trace[pid]);
}

END 
{
    clear(@in_trace);
    clear(@start);
    clear(@checks);
}
