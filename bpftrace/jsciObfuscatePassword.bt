#!/usr/bin/env -S bpftrace --no-warnings 
/*
 * Purpose:
 *   Trace the Oracle kernel and library functions that
 *   are involved in obfuscating a credential password.
 *
 * Date:
 *   Aug-07, 2026
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *   ./jsciObfuscatePassword.bt <pid>
 *
 * Tested on:
 *   Oracle 23.26.0 / Exadata 25.2.1
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 * 
 *   Use at your own risk!
 */

BEGIN
{
    if ($# < 1 || $# > 3) {
        printf("\nUsage: ./jsciObfuscatePassword.bt <pid>\n");
        exit();
    }

    printf("Tracing... Hit ^C to stop.\n\n");

    if (str($2) == "verbose" || str($2) == "v" || str($2) == "yes" || str($2) == "y") {
        @OPT_VERBOSE = 1;
    }

    if (str($3) == "all" || str($3) == "a" || str($3) == "yes" || str($3) == "y") {
        @OPT_ALL = 1;
    }
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciObfuscatePassword
/ (pid == $1 && arg1 != 0) || (pid == $1 && @OPT_ALL) /
{
    @in_trace[pid] = 1;
    printf("%ld %s -> jsciObfuscatePassword: pwd=0x%lx, len=%d, ...\n", pid, comm, arg0, arg1);
    printf("%ld %s    str(0x%lx) = %s\n", pid, comm, arg0, str(uptr(arg0)));
}

uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciObfuscatePassword
/ @in_trace[pid] /
{
    printf("%ld %s <- jsciObfuscatePassword: 0x%lx (%ld)\n\n", pid, comm, retval, retval);
    delete(@in_trace[pid]);
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciGetObfKey
/ @in_trace[pid] && @OPT_VERBOSE /
{
    @in_obfkey[pid] = 1;
    @a0_obfkey[pid] = (uint64) arg0;
    printf("%ld %s -> jsciGetObfKey: buf=0x%lx, ..., cred_user=%p, cred_user_len=%d, cred_owner=0x%lx, cred_owner_len=%d\n", pid, comm, arg0, arg2, arg3, arg4, arg5);
}

uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciGetObfKey
/ @in_trace[pid] && @OPT_VERBOSE /
{
    printf("%ld %s    str(0x%lx) = %s\n", pid, comm, @a0_obfkey[pid], str(uptr(@a0_obfkey[pid])));
    printf("%ld %s <- jsciGetObfKey: 0x%lx (%ld)\n", pid, comm, retval, retval);

    delete(@a0_obfkey[pid]);
    delete(@in_obfkey[pid]);
}

uprobe:/lib64/libc.so.6:sprintf
/ @in_trace[pid] && @in_obfkey[pid] /
{
    printf("%ld %s -> sprintf: str=0x%lx, ..., value=%u\n", pid, comm, arg0, arg2);
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:__intel_sse2_strncat
/ @in_trace[pid] && @in_obfkey[pid] /
{
    printf("%ld %s -> __intel_sse2_strncat: 0x%lx, 0x%lx, src=0x%lx, ...\n", pid, comm, arg0, arg1, arg2);
    printf("%ld %s    str(src) = %s\n", pid, comm, str(uptr(arg2)));
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciEncodeBase64
/ @in_trace[pid] /
{
    printf("%ld %s -> jsciEncodeBase64: buf=0x%lx, bytes=%d, 0x%lx, 0x%lx\n", pid, comm, arg0, arg1, arg2, arg3);
}

uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/bin/oracle:jsciEncodeBase64
/ @in_trace[pid] /
{
    printf("%ld %s <- jsciEncodeBase64: 0x%lx (%ld)\n", pid, comm, retval, retval);
}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/lib/libnnzsrv.so:ztcsh
/ @in_trace[pid] /
{
    @a0_ztcsh[pid] = (uint64) arg0;

    printf("%ld %s -> ztcsh: buf=0x%lx, ..., pwd=0x%lx, len=%d, ...\n", 
           pid, comm, arg0, arg2, arg3);
}

