/ @in_trace[pid] /
{
    $a0 = @a0_ztcsh[pid];

    printf("%ld %s    buf r: 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", 
