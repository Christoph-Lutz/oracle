           *(uint8 *) uptr($a0 + 4),  *(uint8 *) uptr($a0 + 5),  *(uint8 *) uptr($a0 + 6),  *(uint8 *) uptr($a0 + 7),
           *(uint8 *) uptr($a0 + 8),  *(uint8 *) uptr($a0 + 9),  *(uint8 *) uptr($a0 + 10), *(uint8 *) uptr($a0 + 11),
           *(uint8 *) uptr($a0 + 12), *(uint8 *) uptr($a0 + 13), *(uint8 *) uptr($a0 + 14), *(uint8 *) uptr($a0 + 15)
    );

    printf("%ld %s           0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", 
           pid, comm,
           *(uint8 *) uptr($a0 + 16),  *(uint8 *) uptr($a0 + 17),  *(uint8 *) uptr($a0 + 18), *(uint8 *) uptr($a0 + 19),
           *(uint8 *) uptr($a0 + 20),  *(uint8 *) uptr($a0 + 21),  *(uint8 *) uptr($a0 + 22), *(uint8 *) uptr($a0 + 23),
           *(uint8 *) uptr($a0 + 24),  *(uint8 *) uptr($a0 + 25),  *(uint8 *) uptr($a0 + 26), *(uint8 *) uptr($a0 + 27),
           *(uint8 *) uptr($a0 + 28),  *(uint8 *) uptr($a0 + 29),  *(uint8 *) uptr($a0 + 30), *(uint8 *) uptr($a0 + 31)
    );

    printf("%ld %s           0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", 
           pid, comm,
           *(uint8 *) uptr($a0 + 32),  *(uint8 *) uptr($a0 + 33),  *(uint8 *) uptr($a0 + 34), *(uint8 *) uptr($a0 + 35),
           *(uint8 *) uptr($a0 + 36),  *(uint8 *) uptr($a0 + 37),  *(uint8 *) uptr($a0 + 38), *(uint8 *) uptr($a0 + 39),
           *(uint8 *) uptr($a0 + 40),  *(uint8 *) uptr($a0 + 41),  *(uint8 *) uptr($a0 + 42), *(uint8 *) uptr($a0 + 43),
           *(uint8 *) uptr($a0 + 44),  *(uint8 *) uptr($a0 + 45),  *(uint8 *) uptr($a0 + 46), *(uint8 *) uptr($a0 + 47)
    );

    printf("%ld %s <- ztcsh: 0x%lx (%ld)\n", pid, comm, retval, retval);

    delete(@a0_ztcsh[pid]);
}

