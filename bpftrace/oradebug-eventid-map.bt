#!/usr/bin/env -S bpftrace --no-warning
/*
 * Purpose:
 *   Probe the function dbgfcsIlcsGetNextDef to map the 
 *   trace events shown by "oradebug doc event name" to 
 *   their internal event ids.
 *
 * Date:
 *   Mar-05 2025
 *
 * Author:
 *   Christoph Lutz
 *
 * Usage:
 *     ./oradebug-event-map.bt <oracle_sid>
 *
 * Credits:
 *   Hatem Mahmoud, Oracle trace events hunting : dbgdChkEventIntV, 2018-10-12
 *   https://mahmoudhatem.wordpress.com/2018/10/12/oracle-trace-events-hunting-dbgdchkeventintv/
 *
 *   Hatem Mahmoud, Oracle trace events hunting : Undocumented events/Filling the gaps, 2018-10-18
 *   https://mahmoudhatem.wordpress.com/2018/10/18/oracle-trace-events-hunting-undocumented-events-filling-the-gaps/
 *
 * Tested on:
 *   Oracle 19.24
 *
 * Notes:
 *   Adjust the ORACLE_HOME path for your environment.
 *
 *   Adjust the version dependent defines.
 *  
 *   Use at your own risk!
 * 
 *   The elements in the array dbgfilcsCompDefTab point
 *   to the component descriptions (more research needed).
 *
 * Background information:
 *   Function dbgdEventHelp loops over the event defintion 
 *   table dbgfilcsEventDefTab using dbgfcsIlcsGetNextDef.
 *
 *   Function dbgfcsIlcsGetNextDef has the following arg 
 *   and return:
 *      - arg3: event id pointer
 *              This is an in/out param set to 0 on first
 *              iteration, but then changed to the next
 *              event id before the function returns.
 *      - ret:  event defintion pointer
 *               
 *   Event definition pointers are stored in dbgfilcsEventDefTab
 *   and have the following structure:
 *     - offset 0x00: library struct pointer
 *     - offset 0x08: event name string
 *     - offset 0x10: event flag
 *
 *   The event flags seem to have the following meaning:
 *     - 0x001: documented oradebug event
 *     - 0x002: documented oradebug event
 *     - 0x004: event filter (oradebug doc event filter ...)
 *     - 0x800: undocumented oradebug event
 *
 *   Library definition pointers are stored in dbgfcsLibDefTab.
 *   A library definition has a size of 0x20 and the library
 *   "short" string name is stored at offset 0x8.
 */

/* version dependent: may change in every RU!             */
#define KSPSSIDST_ADDR 0x60009628  /* sid name            */
#define LIB_DEF_TAB    0x18416ac0  /* dbgfcsLibDefTab     */
#define LIB_ELEM_SZ    0x20        /* lib element size    */
#define LIB_STR_OFF    0x8         /* library str offset  */
#define EV_STR_OFF     0x8         /* event str offset    */
#define EV_FLG_OFF     0x10        /* event flag offset   */
#define EV_MASK_UNDOC  0x800       /* undocumented flag   */
#define EV_MASK_PR1    0x1         /* print flag 1        */
#define EV_MASK_PR2    0x2         /* print flag 2        */
#define EV_MASK_FILTER 0x4         /* event filter flag   */

BEGIN
{
    if ($# != 1) {
        printf("\nUsage: ./oradebug-eventid-map.bt <oracle_sid>\n");
        exit();
    }
    printf("\nReady. Run 'oradebug doc event name' now ... Hit Ctrl + C to stop.\n");
    printf("\n%-10s %-30s %-10s %-10s\n", "LIBRARY", "EVENT", "EVENT_ID", "DOCUMENTED");
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1923_1/bin/oracle:dbgdEventHelp
/ str(uptr(KSPSSIDST_ADDR)) == str($1) /
{
    @in_help[pid] = 1;
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1923_1/bin/oracle:dbgdEventHelp
/ @in_help[pid] /
{
    delete(@in_help[pid]);
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1923_1/bin/oracle:dbgfcsIlcsGetNextDef
/ @in_help[pid] /
{
    @ev_id_p[pid] = arg3;
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1923_1/bin/oracle:dbgfcsIlcsGetNextDef
/ @in_help[pid] /
{
    /* event definition */
    $ev_id    = *(uint64 *) @ev_id_p[pid];  
    $ev_def_p = (uint64) retval;
    $ev_str_p = *(uint64 *) ($ev_def_p + EV_STR_OFF);
    $ev_flg   = *(uint64 *) ($ev_def_p + EV_FLG_OFF);

    /* library definition */
    $lib_id    = *(uint64 *) $ev_def_p;
    $lib_str_p = *(uint64 *)(LIB_DEF_TAB + ($lib_id * LIB_ELEM_SZ) + LIB_STR_OFF);

    if (!($ev_flg & EV_MASK_FILTER) && ($ev_flg & EV_MASK_PR1 || $ev_flg & EV_MASK_PR2)) {
        printf("%-10s %-30s %-10p %-10s\n", str(uptr($lib_str_p)), str(uptr($ev_str_p)), $ev_id,
               ($ev_flg & EV_MASK_UNDOC) ? "NO" : "YES");
    }
    delete(@ev_id_p[pid]);
}

END
{
    clear(@ev_id_p);
}
