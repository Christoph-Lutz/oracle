uretprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/lib/libnnzsrv.so:aesni_cbc_encrypt
/ @in_trace_wf[pid] || @in_trace_rf[pid] /
{
    $a1 = (uint64) @out[pid];

    printf("%ld %s    out r: 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", pid, comm,
