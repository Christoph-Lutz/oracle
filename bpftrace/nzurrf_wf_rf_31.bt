}

uprobe:/u01/app/oracle/product/26.0.0.0/dbhome_260_1/lib/libnnzsrv.so:aesni_cbc_encrypt
/ @in_trace_wf[pid] || @in_trace_rf[pid] /
{
    $a0 = (uint64) arg0;
    $a4 = (uint64) arg4;
    @out[pid] = (uint64) arg1;

    printf("%ld %s -> aesni_cbc_encrypt: in=%p, out=%p, length=%d, key=%p, ivec=%p, enc=%d\n", pid, comm, arg0, arg1, arg2, arg3, arg4, arg5);

    printf("%ld %s    in e : 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", pid, comm,
           *(uint8 *) uptr($a0 + 0),  *(uint8 *) uptr($a0 + 1),  *(uint8 *) uptr($a0 + 2),  *(uint8 *) uptr($a0 + 3),
           *(uint8 *) uptr($a0 + 4),  *(uint8 *) uptr($a0 + 5),  *(uint8 *) uptr($a0 + 6),  *(uint8 *) uptr($a0 + 7),
           *(uint8 *) uptr($a0 + 8),  *(uint8 *) uptr($a0 + 9),  *(uint8 *) uptr($a0 + 10), *(uint8 *) uptr($a0 + 11),
           *(uint8 *) uptr($a0 + 12), *(uint8 *) uptr($a0 + 13), *(uint8 *) uptr($a0 + 14), *(uint8 *) uptr($a0 + 15)
    );

    printf("%ld %s    iv e : 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x 0x%02x\n", pid, comm,
           *(uint8 *) uptr($a4 + 0),  *(uint8 *) uptr($a4 + 1),  *(uint8 *) uptr($a4 + 2),  *(uint8 *) uptr($a4 + 3),
           *(uint8 *) uptr($a4 + 4),  *(uint8 *) uptr($a4 + 5),  *(uint8 *) uptr($a4 + 6),  *(uint8 *) uptr($a4 + 7),
           *(uint8 *) uptr($a4 + 8),  *(uint8 *) uptr($a4 + 9),  *(uint8 *) uptr($a4 + 10), *(uint8 *) uptr($a4 + 11),
           *(uint8 *) uptr($a4 + 12), *(uint8 *) uptr($a4 + 13), *(uint8 *) uptr($a4 + 14), *(uint8 *) uptr($a4 + 15)
