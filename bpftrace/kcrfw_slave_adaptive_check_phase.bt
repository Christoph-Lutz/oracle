uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_slave_adaptive_start_ow
/ str(uptr(KSPSSIDST)) == str($1) /
{
    @in_trace[pid] = 1;

    @pic[pid]    = (uint64) arg0;
    @lg_grp[pid] = (uint32) arg1;
    @lg_slv[pid] = (uint32) arg2;

    $fsbase              = uptr(curtask->thread.fsbase);
    $saddr               = *(uint64 *) uptr($fsbase - KSUSE_TLS_OFF);
    $stats               = *(uint64 *) uptr($saddr + KSUSE_STATS_OFF);
    @writes_all[pid]     = *(uint64 *) uptr($stats + STA_REDO_WRI_ADAPT_ALL * 8);
    @writes_worker[pid]  = *(uint64 *) uptr($stats + STA_REDO_WRI_ADAPT_WRKR * 8);

    @fast_sync[pid]       = *(uint32 *) uptr(KCRF_FAST_SYNC);
    @kcrf_slave_info[pid] = *(uint32 *) uptr(KCRF_SLAVE_INFO);
    @lgwr_mode[pid]       = *(uint32 *) uptr(KCRFWSLV_LGWR_MODE);
    @lgwr_stdby_mode[pid] = *(uint32 *) uptr(KCRFWSLV_STDBY_MODE);

    $alwe                 = *(struct alwe_info **) uptr(KLASSVP7); 
    @pic_start[pid]       = $alwe->pic_start;
    @epoch_ts[pid]        = $alwe->epoch_ts;
    @alwe_flags[pid]      = $alwe->flags;

    /* 
     * In serial mode, get the lg_grp
     * from kcrfwslv_my_info stored in 
     * tls and set lg_slv to 0.
     */
    if (!@lgwr_mode[pid]) {
        @lg_grp[pid] = **(uint64 **) uptr($fsbase - KCRFWSLV_MY_INFO_TLS_OFF);
        @lg_slv[pid] = 0;
    }

    printf("%ld %s -> kcrfw_slave_adaptive_start_ow: pic=0x%lx, grp?=0x%lx, slv?=0x%lx, 0x%lx, 0x%lx, 0x%lx\n",
           pid, comm, @pic[pid], arg1, arg2, arg3, arg4, arg5);
    printf("%ld %s    lgwr_mode = %u\n", pid, comm, @lgwr_mode[pid]);
    printf("%ld %s    lgwr_stdby_mode = %u\n", pid, comm, @lgwr_stdby_mode[pid]);
    printf("%ld %s    alwe_flags = %p\n", pid, comm, @alwe_flags[pid]);
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_slave_adaptive_start_ow
/ @in_trace[pid] /
{
    $alwe          = *(struct alwe_info **) uptr(KLASSVP7); 
    $fsbase        = uptr(curtask->thread.fsbase);
    $saddr         = *(uint64 *) uptr($fsbase - KSUSE_TLS_OFF);
    $stats         = *(uint64 *) uptr($saddr + KSUSE_STATS_OFF);
    $writes_all    = *(uint64 *) uptr($stats + STA_REDO_WRI_ADAPT_ALL * 8);
    $writes_worker = *(uint64 *) uptr($stats + STA_REDO_WRI_ADAPT_WRKR * 8);

    /* Precondition checks */
    $skip = 0;
    if (@fast_sync[pid]) {
        $skip = SKIP_KCRF_FAST_SYNC;
    }

    if (!$skip && (@kcrf_slave_info[pid] != OLRW_FLG_ENABLED)) {
        $skip = SKIP_KCRF_SLAVE_INFO_OLRW;
    }

    if (!$skip && @lgwr_stdby_mode[pid]) {
        $skip = SKIP_KCRFWSLV_STDBY_MODE;
    }

    if (!$skip && ! *(uint32 *) uptr(@pic[pid] + KCRFPIC_BLKS_OFF)) {
        $skip = SKIP_KCRFSPIC_BLKS;
    }

    if($skip) {
        printf("%ld %s    Skip: reason: %s\n", pid, comm, @STR_SKIP[$skip]);
    }
    else {

        if (!@pic_start[pid]) {
            printf("%ld %s    Setting alwe->pic_start to: 0x%lx (%ld)\n", pid, comm, @epoch_ts[pid], @epoch_ts[pid]);
            printf("%ld %s    ALWE: (%u, %u): Non-overlapped %s write starting: ow_start=0x%lx\n", 
                   pid, comm, @lg_grp[pid], @lg_slv[pid], (@lgwr_mode[pid] ? "parallel" : "serial"), $alwe->pic_start);
        }
        else {
            printf("%ld %s    ALWE: (%u, %u): Overlapped %s write starting: ow_start=0x%lx\n", 
                   pid, comm, @lg_grp[pid], @lg_slv[pid], (@lgwr_mode[pid] ? "parallel" : "serial"), @pic_start[pid]);
        }

        printf("%ld %s    Setting klassvu1_ to: 0x%lx (%ld)\n", pid, comm, $alwe->pic_start, $alwe->pic_start);

        /* 
         * Note: Oracle only increments the
         * session stat counters below during
         * the normal phase; they are not in-
         * cremented during the evaluation
         * phase!
         */
        printf("%ld %s    %-30s %16s %16s %16s\n", pid, comm, "session stats", "begin", "end", "diff");
        printf("%ld %s    %-30s %16ld %16ld %16ld\n", pid, comm, "  redo writes adaptive all", @writes_all[pid], $writes_all, ($writes_all - @writes_all[pid]));
        printf("%ld %s    %-30s %16ld %16ld %16ld\n", pid, comm, "  redo writes adaptive worker", @writes_worker[pid], $writes_worker, ($writes_worker - @writes_worker[pid]));
    }

    printf("%ld %s <- kcrfw_slave_adaptive_start_ow\n\n", pid, comm);

    delete(@in_trace[pid]);
    delete(@pic[pid]);
    delete(@lg_grp[pid]);
    delete(@lg_slv[pid]);
    delete(@writes_all[pid]);
    delete(@writes_worker[pid]);
    delete(@fast_sync[pid]);
    delete(@kcrf_slave_info[pid]);
    delete(@lgwr_mode[pid]);
    delete(@lgwr_stdby_mode[pid]);
    delete(@pic_start[pid]);
    delete(@epoch_ts[pid]);
    delete(@alwe_flags[pid]);
}

uprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_slave_adaptive_end_ow
/ str(uptr(KSPSSIDST)) == str($1) /
{
    @in_trace[pid] = 1;

    $alwe = *(struct alwe_info **) uptr(KLASSVP7); 

    @pic[pid]             = (uint64) arg0;

    @fast_sync[pid]       = *(uint32 *) uptr(KCRF_FAST_SYNC);
    @kcrf_slave_info[pid] = *(uint32 *) uptr(KCRF_SLAVE_INFO);
    @lgwr_mode[pid]       = *(uint32 *) uptr(KCRFWSLV_LGWR_MODE);
    @lgwr_stdby_mode[pid] = *(uint32 *) uptr(KCRFWSLV_STDBY_MODE);
    @klassvu1[pid]        = *(uint64 *) uptr(KLASSVU1);
    @blocks[pid]          = *(uint32 *) uptr(@pic[pid] + KCRFPIC_BLKS_OFF);

    $fsbase               = uptr(curtask->thread.fsbase);
    @slv_my_info[pid]     = *(uint64 *) uptr($fsbase - KCRFWSLV_MY_INFO_TLS_OFF);

    @pic_start[pid]       = $alwe->pic_start;
    @ow_blocks[pid]       = $alwe->ow_blocks;
    @ow_blocks_new[pid]   = ($alwe->ow_blocks + @blocks[pid]);
    @tot_time[pid]        = $alwe->tot_time;
    @tot_blocks[pid]      = $alwe->tot_blocks;
    @ol_writes[pid]       = $alwe->ol_writes;
    @eval_writes[pid]     = $alwe->eval_writes;
    @blocks_fraction[pid] = $alwe->blocks_fraction;
    @normal_writes[pid]   = $alwe->normal_writes;
    @alwe_flags[pid]      = $alwe->flags;

    printf("%ld %s -> kcrfw_slave_adaptive_end_ow: pic=0x%lx\n", pid, comm, @pic[pid]);
    printf("%ld %s    lgwr_mode = %u\n", pid, comm, @lgwr_mode[pid]);
    printf("%ld %s    lgwr_stdby_mode = %u\n", pid, comm, @lgwr_stdby_mode[pid]);
    printf("%ld %s    alwe_flags = %p\n", pid, comm, @alwe_flags[pid]);
    printf("%ld %s    blocks = %u\n", pid, comm, @blocks[pid]);
    printf("%ld %s    ow_blocks = %u\n", pid, comm, $alwe->ow_blocks);
    printf("%ld %s    ow_blocks_new = %u\n", pid, comm, @ow_blocks_new[pid]);
}

uretprobe:/u01/app/oracle/product/19.0.0.0/dbhome_1926_1/bin/oracle:kcrfw_slave_adaptive_end_ow
/ @in_trace[pid] /
{
    $alwe = *(struct alwe_info **) uptr(KLASSVP7); 
    $lg_grp = *(uint32 *) uptr(@slv_my_info[pid]);
    $lg_slv = *(uint32 *) uptr(@slv_my_info[pid] + 4);

    /* Precondition checks */
    $skip = 0;
    if (@fast_sync[pid]) {
        $skip = SKIP_KCRF_FAST_SYNC;
    }

    if (!$skip && (@kcrf_slave_info[pid] != OLRW_FLG_ENABLED)) {
        $skip = SKIP_KCRF_SLAVE_INFO_OLRW;
    }

    if (!$skip && @lgwr_stdby_mode[pid]) {
        $skip = SKIP_KCRFWSLV_STDBY_MODE;
    }

    if($skip) {
        printf("%ld %s    Skip: reason: %s\n", pid, comm, @STR_SKIP[$skip]);
    }
    else {

        /* Anomalies */
        if (!@pic_start[pid] || ! @klassvu1[pid] || @klassvu1[pid] != @pic_start[pid]) {
            printf("%ld %s    ALWE: (%u, %u): %s write anomaly: pic_start=0x%lx, ow_start=0x%lx\n", 
                   pid, comm, $lg_grp, $lg_slv, (@lgwr_mode[pid] ? "parallel" : "serial"), @pic_start[pid], @klassvu1[pid]);
        }

        /* 
         * Note:
         * When, on function return, the number of 
         * ow_blocks in the alwe struct matches the 
         * sum of the ow_blocks and redo blocks in 
         * the pic (pending I/O context) on function 
         * entry, this indicates an overlapped redo 
         * write.
         * Note that we cannot easily measure the 
         * "active=(grp,slv)" and "ow_time" values 
         * with bpftrace, which is why we do not
         * show them in the printf below.
         */
        if ($alwe->ow_blocks == @ow_blocks_new[pid]) {
            printf("%ld %s    ALWE: (%u, %u): In %s overlapped write: active=(n/a, n/a), blks=%u, ow_time=n/a, start=(0x%lx, 0x%lx)\n",
                   pid, comm, $lg_grp, $lg_slv, (@lgwr_mode[pid] ? "parallel" : "serial"), @blocks[pid], @klassvu1[pid], @pic_start[pid]);
        }
        /* Non-overlapped redo write */
        else {
            printf("%ld %s    In %s non-overlapped write (alwe->ow_blocks=%u)\n", 
                   pid, comm, (@lgwr_mode[pid] ? "parallel" : "serial"), $alwe->ow_blocks);    
        }

        printf("%ld %s    ALWE: (%u, %u): End of %s overlapped %s write: ow_blks=%u, ow_time=n/a, start=(0x%lx, 0x%lx)\n", 
               pid, comm, $lg_grp, $lg_slv, ($alwe->flags & 1 ? "normal" : "evaluative"), (@lgwr_mode[pid] ? "parallel" : "serial"),
               @blocks[pid], @klassvu1[pid], @pic_start[pid]);

        printf("%ld %s    %-18s %16s %16s %16s\n", pid, comm, "alwe stat", "begin", "end", "diff");
        printf("%ld %s    %-18s %16ld %16ld %16ld\n", pid, comm, "  ow_blocks", @ow_blocks[pid], $alwe->ow_blocks, ($alwe->ow_blocks - @ow_blocks[pid]));
        printf("%ld %s    %-18s %16ld %16ld %16s\n", pid, comm, "  pic_start", @pic_start[pid], $alwe->pic_start, "n/a");
        printf("%ld %s    %-18s %16ld %16ld %16d\n", pid, comm, "  tot_time", @tot_time[pid], $alwe->tot_time, ($alwe->tot_time - @tot_time[pid]));
        printf("%ld %s    %-18s %16ld %16ld %16ld\n", pid, comm, "  tot_blocks", @tot_blocks[pid], $alwe->tot_blocks, ($alwe->tot_blocks - @tot_blocks[pid]));
        printf("%ld %s    %-18s %16d %16d %16d\n", pid, comm, "  ol_writes", @ol_writes[pid], $alwe->ol_writes, ($alwe->ol_writes - @ol_writes[pid]));
        printf("%ld %s    %-18s %16d %16d %16d\n", pid, comm, "  eval_writes", @eval_writes[pid], $alwe->eval_writes, ($alwe->eval_writes - @eval_writes[pid]));
        printf("%ld %s    %-18s %16ld %16ld %16ld\n", pid, comm, "  blocks_fraction", @blocks_fraction[pid], $alwe->blocks_fraction, ($alwe->blocks_fraction - @blocks_fraction[pid]));
        printf("%ld %s    %-18s %16ld %16ld %16ld\n", pid, comm, "  normal_writes", @normal_writes[pid], $alwe->normal_writes, ($alwe->normal_writes - @normal_writes[pid]));
    }
    
    printf("%ld %s <- kcrfw_slave_adaptive_end_ow\n\n", pid, comm);

    delete(@in_trace[pid]);
    delete(@pic[pid]);
    delete(@fast_sync[pid]);
    delete(@kcrf_slave_info[pid]);
    delete(@lgwr_mode[pid]);
    delete(@lgwr_stdby_mode[pid]);
    delete(@klassvu1[pid]);
    delete(@blocks[pid]);
    delete(@slv_my_info[pid]);
    delete(@pic_start[pid]);
    delete(@ow_blocks[pid]);
    delete(@ow_blocks_new[pid]);
    delete(@tot_time[pid]);
    delete(@tot_blocks[pid]);
    delete(@ol_writes[pid]);
    delete(@eval_writes[pid]);
    delete(@blocks_fraction[pid]);
    delete(@normal_writes[pid]);
    delete(@alwe_flags[pid]);
    delete(@epoch_ts_cur[pid]);
}

END
{
    /* kcrfw_slave_adaptive_phase_check */
    clear(@in_trace);
    clear(@fast_sync);
    clear(@kcrf_slave_info);
    clear(@lgwr_mode);
    clear(@lgwr_stdby_mode);
    clear(@max_out_lw);
    clear(@kcrfs_seqno);
    clear(@eval_intvl_us);
    clear(@epoch_ts);
    clear(@epoch_ts_cur);
    clear(@epoch_ts_prv);
    clear(@blocks_per_sec);
    clear(@normal_writes);
    clear(@eval_writes);
    clear(@blocks);
    clear(@blocks_fraction);
    clear(@pic_start);
    clear(@anomalies);
    clear(@ol_writes);
    clear(@tot_time);
    clear(@tot_blocks);
    clear(@ow_blocks);
    clear(@seqno);
    clear(@alwe_flags);
    clear(@STR_SKIP);

    /* kcrfw_slave_adaptive_start_ow */
    clear(@lg_grp);
    clear(@lg_slv);
    clear(@writes_all);
    clear(@writes_worker);

    /* kcrfw_slave_adaptive_end_ow */
    clear(@pic);
    clear(@klassvu1);
    clear(@blocks);
    clear(@ow_blocks_new);
    clear(@slv_my_info);
}
